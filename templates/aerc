# {{title}} for aerc
# Built with: {{command}}
#
# A styleset: install it to ~/.config/aerc/stylesets and name it in aerc.conf
# (styleset-name). Flat like the Yazi flavor: no background colours, so the
# terminal's paper shows through, and the selection underlined in ink. Unread
# mail is in ink and bold, read mail muted, flagged and marked mail soft.

*.default=true
*.normal=true
*.selected.reverse=false
*.selected.fg={{ink}}
*.selected.bold=true
*.selected.underline=true

title.fg={{ink}}
title.bold=true
header.fg={{muted}}
header.bold=true

error.fg={{ink}}
error.bold=true
warning.fg={{soft}}
success.fg={{soft}}

statusline_default.fg={{muted}}
statusline_error.fg={{ink}}
statusline_error.bold=true
statusline_success.fg={{soft}}

border.fg={{rule}}
spinner.fg={{soft}}

tab.fg={{muted}}
stack.fg={{muted}}

msglist_default.fg={{text}}
msglist_unread.fg={{ink}}
msglist_unread.bold=true
msglist_read.fg={{muted}}
msglist_flagged.fg={{soft}}
msglist_flagged.bold=true
msglist_deleted.fg={{faint}}
msglist_marked.fg={{soft}}
msglist_result.fg={{soft}}
msglist_answered.fg={{muted}}
msglist_forwarded.fg={{muted}}
msglist_thread_folded.fg={{muted}}
msglist_thread_context.fg={{faint}}
msglist_gutter.fg={{rule}}
msglist_pill.fg={{soft}}

dirlist_default.fg={{text}}
dirlist_unread.fg={{ink}}
dirlist_unread.bold=true
dirlist_recent.fg={{soft}}

part_switcher.fg={{muted}}
part_filename.fg={{text}}
part_mimetype.fg={{muted}}

completion_default.fg={{text}}
completion_gutter.fg={{rule}}
completion_pill.fg={{soft}}

selector_default.fg={{text}}
selector_focused.fg={{ink}}
selector_focused.bold=true
selector_focused.underline=true
selector_chooser.fg={{soft}}
selector_chooser.bold=true

# The message viewer, as coloured by aerc's colorize filter.
[viewer]
url.fg={{soft}}
url.underline=true
header.fg={{muted}}
header.bold=true
signature.fg={{faint}}
diff_meta.fg={{ink}}
diff_meta.bold=true
diff_chunk.fg={{soft}}
diff_chunk_func.fg={{soft}}
diff_add.fg={{ink}}
diff_del.fg={{muted}}
quote_1.fg={{soft}}
quote_2.fg={{muted}}
quote_3.fg={{faint}}
quote_4.fg={{faint}}
quote_x.fg={{faint}}
