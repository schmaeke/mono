// Mono Light for gitui
//
// Additions are set in ink, deletions in muted, changes in soft, like the
// diff colors of the Helix theme. Code views use the mono-light tmTheme.
(
    selected_tab: Some("#000000"),
    block_title_focused: Some("#000000"),

    selection_bg: Some("#c4c4c4"),
    selection_fg: Some("#000000"),
    use_selection_fg: Some(true),

    cmdbar_bg: Some("#f2f2f2"),
    command_fg: Some("#2b2b2b"),
    disabled_fg: Some("#686868"),

    diff_line_add: Some("#000000"),
    diff_line_delete: Some("#686868"),
    diff_file_added: Some("#000000"),
    diff_file_removed: Some("#686868"),
    diff_file_moved: Some("#2b2b2b"),
    diff_file_modified: Some("#484848"),

    commit_hash: Some("#484848"),
    commit_time: Some("#686868"),
    commit_author: Some("#2b2b2b"),
    branch_fg: Some("#000000"),
    tag_fg: Some("#484848"),

    danger_fg: Some("#000000"),
    push_gauge_bg: Some("#c4c4c4"),
    push_gauge_fg: Some("#000000"),

    syntax: Some("mono-light"),
)
