// Mono Dark for gitui
//
// Additions are set in ink, deletions in muted, changes in soft, like the
// diff colors of the Helix theme. Code views use the mono-dark tmTheme.
(
    selected_tab: Some("#ffffff"),
    block_title_focused: Some("#ffffff"),

    selection_bg: Some("#373737"),
    selection_fg: Some("#ffffff"),
    use_selection_fg: Some(true),

    cmdbar_bg: Some("#121212"),
    command_fg: Some("#d4d4d4"),
    disabled_fg: Some("#838383"),

    diff_line_add: Some("#ffffff"),
    diff_line_delete: Some("#838383"),
    diff_file_added: Some("#ffffff"),
    diff_file_removed: Some("#838383"),
    diff_file_moved: Some("#d4d4d4"),
    diff_file_modified: Some("#ababab"),

    commit_hash: Some("#ababab"),
    commit_time: Some("#838383"),
    commit_author: Some("#d4d4d4"),
    branch_fg: Some("#ffffff"),
    tag_fg: Some("#ababab"),

    danger_fg: Some("#ffffff"),
    push_gauge_bg: Some("#373737"),
    push_gauge_fg: Some("#ffffff"),

    syntax: Some("mono-dark"),
)
